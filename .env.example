# Copy to .env (git-ignored) and fill in. The Supabase CLI reads it directly
# (`supabase functions serve --env-file .env`, `supabase secrets set --env-file .env.prod`).
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Shared secret with canon-inference (same value in its .env). The Edge Functions send it.
INFERENCE_API_KEY=

# Where the Edge Functions reach the inference service.
#   local: http://host.docker.internal:8001     production: the public URL of canon-inference
INFERENCE_URL=http://host.docker.internal:8001

# Cloudflare R2 (audio)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Chat LLM (production needs a hosted, public endpoint)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# LLM_REASONING_EFFORT=none
# LLM_TIMEOUT_MS=90000

